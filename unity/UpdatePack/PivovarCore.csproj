<Project Sdk="Microsoft.NET.Sdk">
  <!-- Stejné zdrojové soubory jako asmdef PivovarCore v Unity, ale přeložené v CI (bez Unity) → PivovarCore.dll pro aktualizaci bez nového stahování. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PivovarCore</AssemblyName>
    <RootNamespace>Pivovar</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/Pivovar/Core/**/*.cs" />
  </ItemGroup>
</Project>
