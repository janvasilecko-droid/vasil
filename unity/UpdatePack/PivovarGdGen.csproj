<Project Sdk="Microsoft.NET.Sdk">
  <!-- Přeložený kód z Godotu (simulace, ovládání, rozvaděč…) jako samostatná knihovna – nahrazuje se při aktualizaci. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PivovarGdGen</AssemblyName>
    <RootNamespace>Pivovar</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/Pivovar/GdGen/**/*.cs" />
    <ProjectReference Include="PivovarCore.csproj" />
  </ItemGroup>
</Project>
